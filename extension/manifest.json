{
  "manifest_version": 3,
  "name": "Full Stockfish 19 — Live Board",
  "version": "0.8.0",
  "description": "Minimal standalone Full Stockfish 19 with live Chess.com board reading.",
  "host_permissions": [
    "https://www.chess.com/*",
    "https://chess.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.chess.com/*",
        "https://chess.com/*"
      ],
      "js": [
        "board.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "offscreen"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "minimum_chrome_version": "116"
}
