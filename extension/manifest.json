{
  "manifest_version": 3,
  "name": "Chess Study Coach — No Screen Share",
  "version": "0.6.10",
  "description": "Board-aware local Stockfish analysis with adjustable search time and diagnostics.",
  "host_permissions": [
    "https://www.chess.com/*",
    "https://chess.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.chess.com/*",
        "https://chess.com/*"
      ],
      "js": [
        "board.js",
        "content.js"
      ],
      "css": [
        "overlay.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage",
    "scripting",
    "tabs"
  ],
  "options_page": "options.html",
  "action": {
    "default_title": "Chess Screen Coach — view suggestion and repair",
    "default_popup": "popup.html"
  }
}
