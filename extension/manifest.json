{
  "manifest_version": 3,
  "name": "Stockfish 19 — Terminal",
  "version": "0.8.0",
  "description": "Full-strength native Stockfish 19 with a minimal live-board display.",
  "host_permissions": [
    "https://www.chess.com/*",
    "https://chess.com/*",
    "http://127.0.0.1:8765/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.chess.com/*",
        "https://chess.com/*"
      ],
      "js": [
        "board.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
