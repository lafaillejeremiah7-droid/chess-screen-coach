{
  "manifest_version": 3,
  "name": "Chess Study Coach — No Screen Share",
  "version": "0.3.1",
  "description": "Read positions on Chess.com boards and send FEN to local Python Stockfish. No screen recording.",
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.chess.com/*",
        "https://chess.com/*"
      ],
      "js": [
        "board.js",
        "content.js"
      ],
      "css": [
        "overlay.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
