{
  "manifest_version": 3,
  "name": "Chess Study Coach — No Screen Share",
  "version": "0.6.6",
  "description": "Practice-only local Stockfish recommendations with live-adjustable Elo and search time.",
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.chess.com/*",
        "https://chess.com/*"
      ],
      "js": [
        "board.js",
        "content.js"
      ],
      "css": [
        "overlay.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage"
  ],
  "options_page": "options.html"
}
