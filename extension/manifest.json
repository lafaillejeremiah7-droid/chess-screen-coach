{
  "manifest_version": 3,
  "name": "Chess Study Coach — Full Stockfish 19",
  "version": "0.7.6",
  "description": "Standalone FULL Stockfish 19 NNUE WASM, no Lite fallback, Python or terminal required.",
  "host_permissions": [
    "https://www.chess.com/*",
    "https://chess.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.chess.com/*",
        "https://chess.com/*"
      ],
      "js": [
        "board.js",
        "content.js"
      ],
      "css": [
        "overlay.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage",
    "scripting",
    "tabs",
    "offscreen"
  ],
  "options_page": "options.html",
  "action": {
    "default_title": "Chess Screen Coach — view suggestion and repair",
    "default_popup": "popup.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "minimum_chrome_version": "116"
}
